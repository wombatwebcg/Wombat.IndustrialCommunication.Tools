<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wombat.IndustrialCommunication.Tools.ViewModels"
             x:Class="Wombat.IndustrialCommunication.Tools.Views.ComponentNavigationView"
             x:CompileBindings="False">
  <Border Classes="sideCard">
    <Grid RowDefinitions="Auto,*" RowSpacing="10">
      <StackPanel Spacing="2" Grid.Row="0">
        <TextBlock Text="组件导航" Classes="sectionTitle" />
        <TextBlock Text="先选择组件，再在中间区域完成连接或监听。" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>

      <ListBox Grid.Row="1"
               Classes="componentList"
               ItemsSource="{Binding Components}"
               SelectedItem="{Binding SelectedComponent}"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:CommunicationComponentItemViewModel">
            <Border Classes="navCard">
              <Grid ColumnDefinitions="4,*" ColumnSpacing="8">
                <Border Classes="navIndicator" />
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="{Binding DisplayName}" Classes="navTitle" />
                  <TextBlock Text="{Binding CategoryName}" Classes="navTag" />
                  <TextBlock Text="{Binding BadgeSummary}" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Border>
</UserControl>
