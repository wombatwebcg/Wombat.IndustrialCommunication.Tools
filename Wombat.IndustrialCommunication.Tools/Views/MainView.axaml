<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Wombat.IndustrialCommunication.Tools.ViewModels"
             xmlns:views="using:Wombat.IndustrialCommunication.Tools.Views"
             xmlns:model="using:Wombat.IndustrialCommunication.Tools.Models"
             mc:Ignorable="d"
             d:DesignWidth="1600"
             d:DesignHeight="920"
             x:Class="Wombat.IndustrialCommunication.Tools.Views.MainView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False">
  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <UserControl.Styles>
    <Style Selector="Border.topBar">
      <Setter Property="Background" Value="#EAF1FB" />
      <Setter Property="BorderBrush" Value="#C7D7EE" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="Border.sideCard">
      <Setter Property="Background" Value="#F8FAFD" />
      <Setter Property="BorderBrush" Value="#D8E2F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="Border.mainCard">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#D7E3F1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Border.subtleCard">
      <Setter Property="Background" Value="#F6F9FC" />
      <Setter Property="BorderBrush" Value="#D7E3F1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="Border.statusChip">
      <Setter Property="Background" Value="#E8F5EC" />
      <Setter Property="BorderBrush" Value="#9FD3B0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="6,2" />
    </Style>
    <Style Selector="Border.metricCard">
      <Setter Property="Background" Value="#F6F9FC" />
      <Setter Property="BorderBrush" Value="#D7E3F1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="Border.summaryCard">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#CFDDEE" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="#EEF5FF" />
      <Setter Property="BorderBrush" Value="#7DAAF7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Margin" Value="0,0,4,4" />
    </Style>
    <Style Selector="TextBlock.appTitle">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#15253A" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#1D2B3F" />
    </Style>
    <Style Selector="TextBlock.metaLabel">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#5E738C" />
    </Style>
    <Style Selector="TextBlock.metaValue">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#15253A" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#4F647E" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#6C8097" />
    </Style>
    <Style Selector="TextBlock.navTitle">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#1A2B3E" />
    </Style>
    <Style Selector="TextBlock.navTag">
      <Setter Property="Foreground" Value="#2B6FD6" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Border.navCard">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#D7E3F1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="Border.navIndicator">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Width" Value="4" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.navCard">
      <Setter Property="Background" Value="#EAF3FF" />
      <Setter Property="BorderBrush" Value="#2F7DFF" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.navIndicator">
      <Setter Property="Background" Value="#2F7DFF" />
    </Style>
    <Style Selector="ListBoxItem:selected TextBlock.navTitle">
      <Setter Property="Foreground" Value="#173A72" />
    </Style>
    <Style Selector="ListBoxItem:selected TextBlock.navTag">
      <Setter Property="Foreground" Value="#1F61C8" />
    </Style>
    <Style Selector="ListBox.componentList">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.componentList ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.bluetoothPicker">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.bluetoothPicker ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.bluetoothOptionCard">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#D7E3F1" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="8,7" />
    </Style>
    <Style Selector="ListBox.bluetoothPicker ListBoxItem:selected Border.bluetoothOptionCard">
      <Setter Property="Background" Value="#EAF3FF" />
      <Setter Property="BorderBrush" Value="#2F7DFF" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBlock.bluetoothOptionTitle">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#1A2B3E" />
    </Style>
    <Style Selector="TextBlock.bluetoothOptionMeta">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#5E738C" />
    </Style>
    <Style Selector="Button.actionPrimary">
      <Setter Property="Background" Value="#2F7DFF" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#4F95FF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="MinWidth" Value="92" />
    </Style>
    <Style Selector="Button.actionSecondary">
      <Setter Property="Background" Value="#F5F8FC" />
      <Setter Property="Foreground" Value="#23405F" />
      <Setter Property="BorderBrush" Value="#C6D6EA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="MinWidth" Value="92" />
    </Style>
    <Style Selector="Button.actionDanger">
      <Setter Property="Background" Value="#FFF1F1" />
      <Setter Property="Foreground" Value="#B6404F" />
      <Setter Property="BorderBrush" Value="#F0B8BF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="MinWidth" Value="92" />
    </Style>
    <Style Selector="Button.actionPrimary:disabled, Button.actionSecondary:disabled, Button.actionDanger:disabled">
      <Setter Property="Opacity" Value="0.48" />
    </Style>
    <Style Selector="TextBox, ComboBox">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#C9D8EA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#15253A" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#1F3045" />
    </Style>
    <Style Selector="TabControl.contextTabs">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TabControl.contextTabs TabItem">
      <Setter Property="Background" Value="#F7FAFD" />
      <Setter Property="BorderBrush" Value="#D6E2EF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#425873" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <Style Selector="TabControl.contextTabs TabItem:selected">
      <Setter Property="Background" Value="#EAF3FF" />
      <Setter Property="BorderBrush" Value="#2F7DFF" />
      <Setter Property="Foreground" Value="#1F4FA6" />
    </Style>
  </UserControl.Styles>

  <Grid Background="#EDF3F8" RowDefinitions="Auto,*" Margin="6" RowSpacing="6">
    <views:MainHeaderView Grid.Row="0" />

    <Grid Grid.Row="1" ColumnDefinitions="212,*,232" ColumnSpacing="6">
      <views:ComponentNavigationView Grid.Column="0" />
      <views:MainWorkspaceView Grid.Column="1" />
      <views:ContextSidePanelView Grid.Column="2" />
    </Grid>
  </Grid>
</UserControl>
